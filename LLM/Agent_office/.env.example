# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 git 에 올리지 않는다)
# 일부 키만 있어도 동작한다 — 키가 없는 provider 는 config/models.yaml 의 fallback 으로 대체된다.

# ChatGPT  https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Claude   https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gemini   https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Upstage  https://console.upstage.ai/
UPSTAGE_API_KEY=

# (선택) 무료 모델 — FreeLLMAPI 프록시 (langchain-kr/25-FreeLLMAPI-FreeModels 참고)
# 유료 키가 모두 안 될 때 마지막 대안으로 쓰이고, 화면의 '🆓 무료 모델만 사용'을 켜면 이것만 쓴다.
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=

# (선택) LangSmith 추적  https://smith.langchain.com/
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=26-Agent-Office
