# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 git 에 올리지 않는다)
# 일부 키만 있어도 동작한다 — 키가 없는 provider 는 config/models.yaml 의 fallback 으로 대체된다.

# ChatGPT  https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Claude   https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gemini   https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Upstage  https://console.upstage.ai/
UPSTAGE_API_KEY=

# (선택) 무료 모델 — FreeLLMAPI 프록시 (langchain-kr/25-FreeLLMAPI-FreeModels 참고)
# 유료 키가 모두 안 될 때 마지막 대안으로 쓰이고, 화면의 '🆓 무료 모델만 사용'을 켜면 이것만 쓴다.
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=

# (선택) LangSmith 추적  https://smith.langchain.com/
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=26-Agent-Office

# ─── (선택) 🏠 메인 화면 AI 브리핑·아이디어 카드 수집 (core/feeds.py, settings.yaml feeds:) ───
# 뉴스(DuckDuckGo)·GitHub·Hacker News 는 키 없이 동작한다. 아래 키는 있을 때만 그 소스를 켠다.
# GitHub 개인 토큰 (권한 없음/public 읽기만으로 충분) — 검색 한도 10회/분 → 30회/분  https://github.com/settings/tokens
GITHUB_TOKEN=
# Reddit 앱(script 형식) — 읽기 전용 client_credentials  https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=AgentOffice-feeds/1.0 (by u/내아이디)
# 네이버 검색 API (뉴스·블로그)  https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Threads API 키워드 검색 (threads_keyword_search 권한이 있는 액세스 토큰)  https://developers.facebook.com/docs/threads
THREADS_ACCESS_TOKEN=
# X(트위터) 검색 API 는 유료라 넣지 않았다.
