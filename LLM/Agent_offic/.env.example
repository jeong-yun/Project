# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 git 에 올리지 않는다)
# 일부 키만 있어도 동작한다 — 키가 없는 provider 는 config/models.yaml 의 fallback 으로 대체된다.

# ChatGPT  https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Claude   https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gemini   https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Upstage  https://console.upstage.ai/
UPSTAGE_API_KEY=

# (선택) LangSmith 추적  https://smith.langchain.com/
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=26-Agent-Office
