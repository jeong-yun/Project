# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 공유/커밋 금지)

# snort.org 로그인 > 계정 메뉴 > Oinkcode 탭에서 확인. 비워두면 Talos 는 건너뜀
SNORT_OINKCODE=

# Talos 스냅샷 버전 (snort 2.9.20 = 29200)
TALOS_SNORT_VERSION=29200

# ET Open 경로 (rules.emergingthreatspro.com 도 동일 파일 제공)
ET_BASE_URL=https://rules.emergingthreats.net/open/snort-2.9.0

# LLM API 키 (3_0_run_generation.py 의 생성·검토). 모델 선택은 docs/코드참조/LLM_설정.md
UPSTAGE_API_KEY=
OPENAI_API_KEY=
# 나중에 Claude 를 쓸 때
ANTHROPIC_API_KEY=
